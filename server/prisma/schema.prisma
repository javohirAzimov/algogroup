generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  password          String
  name              String
  role              String            @default("user") // "user" | "admin"
  department        String?
  avatarUrl         String?
  birthday          String?           // "MM-DD" e.g. "03-15"
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  xp                Int               @default(0)
  loginStreak       Int               @default(0)
  lastLoginDate     String?           // "YYYY-MM-DD"
  suggestions       Suggestion[]
  announcements     Announcement[]
  chatMessages      ChatMessage[]
  newsPosts         NewsPost[]
  typingScores      TypingScore[]
  sentMessages      BirthdayMessage[] @relation("MessageSender")
  receivedMessages  BirthdayMessage[] @relation("MessageReceiver")
  sentShoutouts     Shoutout[]        @relation("ShoutoutSender")
  receivedShoutouts Shoutout[]        @relation("ShoutoutReceiver")
  badges            UserBadge[]
  tournamentEntries TournamentEntry[]
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  type        String   // "event" | "notice"
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id])
}

model Suggestion {
  id          Int      @id @default(autoincrement())
  subject     String
  message     String
  isAnonymous Boolean  @default(false)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model KnowledgeCategory {
  id           Int      @id @default(autoincrement())
  title        String
  icon         String
  articleCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model Spotlight {
  id        Int      @id @default(autoincrement())
  type      String   // "employee" | "queen"
  name      String
  role      String
  quote     String
  imageUrl  String?
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteMedia {
  id        Int      @id @default(autoincrement())
  key       String   @unique // "management_photo"
  imageUrl  String
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model NewsPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Startup {
  id          Int      @id @default(autoincrement())
  name        String
  tagline     String?
  description String
  logoUrl     String?
  stage       String   @default("Idea")
  teamLead    String
  department  String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TypingScore {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  wpm        Int
  accuracy   Float
  errors     Int
  duration   Int
  wordsTyped Int
  createdAt  DateTime @default(now())
}

model Badge {
  id          Int         @id @default(autoincrement())
  key         String      @unique
  name        String
  description String
  icon        String
  xpReward    Int         @default(0)
  users       UserBadge[]
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  user     User     @relation(fields: [userId], references: [id])
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Tournament {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime          @default(now())
  entries     TournamentEntry[]
}

model TournamentEntry {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  userId       Int
  bestWpm      Int?
  bestAccuracy Float?
  submittedAt  DateTime?
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

model BirthdayMessage {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  message    String
  from       User     @relation("MessageSender",   fields: [fromUserId], references: [id])
  to         User     @relation("MessageReceiver", fields: [toUserId],   references: [id])
  createdAt  DateTime @default(now())
}

model Shoutout {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  message    String
  isBirthday Boolean  @default(false)
  from       User     @relation("ShoutoutSender",   fields: [fromUserId], references: [id])
  to         User     @relation("ShoutoutReceiver", fields: [toUserId],   references: [id])
  createdAt  DateTime @default(now())
}
